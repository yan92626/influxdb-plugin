{
  "manifest_version": 3,
  "name": "InfluxDB3 Head",
  "version": "0.2.0",
  "description": "InfluxDB 3.x 可视化管理工具：库表浏览、SQL/InfluxQL 查询、写入与管理",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
